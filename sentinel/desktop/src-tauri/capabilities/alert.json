{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "alert-window",
  "description": "Non-foreground alert surface; no autostart or notification permissions",
  "windows": ["alert"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ]
}
